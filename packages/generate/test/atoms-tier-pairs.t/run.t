Each pair of tiers keeps the lower tier first, whatever the input order.

  $ cat > down_plain.ml <<EOT
  > [@@@css.atoms [
  >   ("_plain", ["._plain{a:b}"], 1, 0, 1, []);
  >   ("_down", ["._down>*{a:b}"], 0, 0, 1, [])
  > ]]
  > EOT

  $ styled-ppx.generate down_plain.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._down>*{a:b}
  ._plain{a:b}

  $ cat > down_other.ml <<EOT
  > [@@@css.atoms [
  >   ("_other", ["._other:hover{a:b}"], 2, 1, 1, []);
  >   ("_down", ["._down>*{a:b}"], 0, 0, 1, [])
  > ]]
  > EOT

  $ styled-ppx.generate down_other.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._down>*{a:b}
  ._other:hover{a:b}

  $ cat > plain_other.ml <<EOT
  > [@@@css.atoms [
  >   ("_other", ["._other:hover{a:b}"], 2, 1, 1, []);
  >   ("_plain", ["._plain{a:b}"], 1, 0, 1, [])
  > ]]
  > EOT

  $ styled-ppx.generate plain_other.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._plain{a:b}
  ._other:hover{a:b}
