Two libraries, `z_base` and `a_app` (`a_app` depends on `z_base`, so
`z_base`'s rules come first in dependency order), one invocation - each
has one base atom and one conditional (`:hover`) atom. There is no
base/conditional tier any more: no block orders these atoms and no two of
them compete, so they keep definition order, library by library in
dependency order.

  $ mkdir a_app z_base

  $ cat > z_base/z_base.ml <<EOF
  > [@@@css.config [("library-name", "z_base")]]
  > [@@@css ("._a_zbase{color:red;}", "_a_zbase", "0,1,0 own", "color", 1, false)]
  > [@@@css ("._a_zbasehover:hover{color:darkred;}", "_a_zbasehover", "0,2,0 own", "color", 1, false)]
  > let widget () = ()
  > EOF

  $ cat > a_app/main.ml <<EOF
  > [@@@css.config [("library-name", "a_app")]]
  > [@@@css ("._a_aapp{color:blue;}", "_a_aapp", "0,1,0 own", "color", 1, false)]
  > [@@@css ("._a_aapphover:hover{color:darkblue;}", "_a_aapphover", "0,2,0 own", "color", 1, false)]
  > let _ = Z_base.widget
  > EOF

  $ styled-ppx.generate a_app/main.ml z_base/z_base.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_zbase{color:red;}
  ._a_zbasehover:hover{color:darkred;}
  ._a_aapp{color:blue;}
  ._a_aapphover:hover{color:darkblue;}
