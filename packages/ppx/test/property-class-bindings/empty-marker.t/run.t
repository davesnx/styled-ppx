An empty `[%css {||}]` marker keeps its id in production, where there
are no dev markers. Every `$(marker)` reference, local or cross-module,
keeps its condition.

  $ mkdir dev prod
  $ for f in m n box; do
  >   refmt --parse re --print ml $f.re > dev/$f.ml
  >   ../../standalone.exe --env development --impl dev/$f.ml -o dev/$f.ml
  >   refmt --parse re --print ml $f.re > prod/$f.ml
  >   ../../standalone.exe --env production --impl prod/$f.ml -o prod/$f.ml
  > done

