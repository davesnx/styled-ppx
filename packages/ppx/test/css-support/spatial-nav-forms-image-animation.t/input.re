/* css-grammar-draft-properties: CSS Spatial Navigation L1
   (https://drafts.csswg.org/css-spatial-nav-1/), CSS Form Control Styling L1
   (https://drafts.csswg.org/css-forms-1/), CSS Image Animation L1
   (https://drafts.csswg.org/css-image-animation-1/) */
[%css {|spatial-navigation-contain: auto|}];
[%css {|spatial-navigation-contain: contain|}];
[%css {|spatial-navigation-action: auto|}];
[%css {|spatial-navigation-action: focus|}];
[%css {|spatial-navigation-action: scroll|}];
[%css {|spatial-navigation-function: normal|}];
[%css {|spatial-navigation-function: grid|}];
[%css {|input-security: auto|}];
[%css {|input-security: none|}];
[%css {|slider-orientation: auto|}];
[%css {|slider-orientation: left-to-right|}];
[%css {|slider-orientation: right-to-left|}];
[%css {|slider-orientation: top-to-bottom|}];
[%css {|slider-orientation: bottom-to-top|}];
[%css {|image-animation: normal|}];
[%css {|image-animation: paused|}];
[%css {|image-animation: stopped|}];
[%css {|image-animation: running|}];
