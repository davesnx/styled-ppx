/* css-grammar-draft-properties: CSS Page Floats
   (https://drafts.csswg.org/css-page-floats/) */
[%css {|float-reference: inline|}];
[%css {|float-reference: column|}];
[%css {|float-reference: region|}];
[%css {|float-reference: page|}];
[%css {|float-defer: none|}];
[%css {|float-defer: last|}];
[%css {|float-defer: 2|}];
[%css {|float-offset: 0|}];
[%css {|float-offset: 10px|}];
[%css {|float-offset: 10%|}];
