/* css-grammar-missing-properties (2026-09-25): CSS Box Sizing L4,
   https://drafts.csswg.org/css-sizing-4/#propdef-frame-sizing */
[%css {|frame-sizing: auto|}];
[%css {|frame-sizing: content-width|}];
[%css {|frame-sizing: content-height|}];
[%css {|frame-sizing: content-block-size|}];
[%css {|frame-sizing: content-inline-size|}];
