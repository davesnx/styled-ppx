  ];
  [@css.classes [("css-p9fz1w", 0, "N.panel", "prod/n.ml", 5, 2, 9, 0)]];
  [@css.bindings [("N.m", "css-1sem5bw"), ("N.panel", "css-p9fz1w")]];
  [@css.refs
    [
      ("M.m", "prod/n.ml", 6, 6, 9),
      ("M.Inner.m", "prod/n.ml", 7, 6, 15),
      ("Box.Box", "prod/n.ml", 8, 6, 13),
