An empty `[%css {||}]` marker has no content to hash, so its class comes
from where it is bound: the module name, the submodule path, and the
binding name. The class must exist in production too, where labels are
off, and two markers with the same name in different modules must get
different classes.

Development:

  $ refmt --parse re --print ml m.re > m.ml
  $ ../../standalone.exe --env development --impl m.ml -o m.ml
  $ refmt --parse re --print ml n.re > n.ml
  $ ../../standalone.exe --env development --impl n.ml -o n.ml
  $ refmt --parse re --print ml box.re > box.ml
  $ ../../standalone.exe --env development --impl box.ml -o box.ml
  $ refmt --parse re --print ml bare.re > bare.ml
  $ ../../standalone.exe --env development --impl bare.ml -o bare.ml

`M.m`, `M.Inner.m` and `N.m` are three different markers.

  $ refmt --parse ml --print re m.ml
  [@css ".css-1xu3tth-card{color:black;}"];
  [@css ".css-1ct27kl-card.css-1hfcgi6-m{color:green;}"];
  [@css ".css-1j2bl2o-card:not(.css-1hfcgi6-m){color:red;}"];
  [@css.bindings
    [
      ("M.m", "css-1hfcgi6-m"),
      ("M.card", "css-1xu3tth-card css-1ct27kl-card css-1j2bl2o-card"),
      ("M.Inner.m", "css-1lkazb8-m"),
    ]
  ];
  let m = CSS.make("cx-m css-1hfcgi6-m", []);
  let card =
    CSS.make("cx-card css-1xu3tth-card css-1ct27kl-card css-1j2bl2o-card", []);
  module Inner = {
    let m = CSS.make("cx-m css-1lkazb8-m", []);
  };

  $ refmt --parse ml --print re n.ml
  [@css ".css-1ct27kl-panel.css-1x6ohry-m{color:green;}"];
  [@css ".css-j1z3s1-panel.\000M.m\000{color:red;}"];
  [@css ".css-17pii80-panel.\000M.Inner.m\000{color:blue;}"];
  [@css ".css-1gyt5cm-panel.\000Box.Box\000{color:purple;}"];
  [@css.bindings
    [
      ("N.m", "css-1x6ohry-m"),
      (
        "N.panel",
        "css-1ct27kl-panel css-j1z3s1-panel css-17pii80-panel css-1gyt5cm-panel",
      ),
    ]
  ];
  [@css.refs
    [
      ("M.m", "n.ml", 6, 6, 9),
      ("M.Inner.m", "n.ml", 7, 6, 15),
      ("Box.Box", "n.ml", 8, 6, 13),
    ]
  ];
  let _ = M.m;
  let _ = M.Inner.m;
  let _ = Box.Box;
  let m = CSS.make("cx-m css-1x6ohry-m", []);
  let panel =
    CSS.make(
      "cx-panel css-1ct27kl-panel css-j1z3s1-panel css-17pii80-panel css-1gyt5cm-panel",
      [],
    );

  $ refmt --parse ml --print re bare.ml
  [@css ".css-1ed9z13-list > .css-1ltob4l-m{color:blue;}"];
  [@css.bindings
    [("Bare.m", "css-1ltob4l-m"), ("Bare.list", "css-1ed9z13-list")]
  ];
  let m = CSS.make("cx-m css-1ltob4l-m", []);
  let list = CSS.make("cx-list css-1ed9z13-list", []);

  $ styled-ppx.generate m.ml n.ml box.ml bare.ml
  /* This file is generated by styled-ppx, do not edit manually */
  .css-1xu3tth-card{color:black;}
  .css-1ct27kl-card.css-1hfcgi6-m{color:green;}
  .css-1j2bl2o-card:not(.css-1hfcgi6-m){color:red;}
  .css-1ct27kl-panel.css-1x6ohry-m{color:green;}
  .css-j1z3s1-panel.css-1hfcgi6-m{color:red;}
  .css-17pii80-panel.css-1lkazb8-m{color:blue;}
  .css-1gyt5cm-panel.css-10a400j-Box{color:purple;}
  .css-1ed9z13-list > .css-1ltob4l-m{color:blue;}

Production. Labels are off, but every marker keeps a class and every
`$(marker)` reference keeps its condition.

  $ mkdir prod
  $ refmt --parse re --print ml m.re > prod/m.ml
  $ ../../standalone.exe --env production --impl prod/m.ml -o prod/m.ml
  $ refmt --parse re --print ml n.re > prod/n.ml
  $ ../../standalone.exe --env production --impl prod/n.ml -o prod/n.ml
  $ refmt --parse re --print ml box.re > prod/box.ml
  $ ../../standalone.exe --env production --impl prod/box.ml -o prod/box.ml
  $ refmt --parse re --print ml bare.re > prod/bare.ml
  $ ../../standalone.exe --env production --impl prod/bare.ml -o prod/bare.ml

  $ refmt --parse ml --print re prod/m.ml
  [@css.config [("env", "production")]];
  [@css ".css-1xu3tth{color:black;}"];
  [@css ".css-1ct27kl.css-1hfcgi6{color:green;}"];
  [@css ".css-1j2bl2o:not(.css-1hfcgi6){color:red;}"];
  [@css.bindings
    [
      ("M.m", "css-1hfcgi6"),
      ("M.card", "css-1xu3tth css-1ct27kl css-1j2bl2o"),
      ("M.Inner.m", "css-1lkazb8"),
    ]
  ];
  let m = CSS.make("css-1hfcgi6", []);
  let card = CSS.make("css-1xu3tth css-1ct27kl css-1j2bl2o", []);
  module Inner = {
    let m = CSS.make("css-1lkazb8", []);
  };

  $ refmt --parse ml --print re prod/n.ml
  [@css.config [("env", "production")]];
  [@css ".css-1ct27kl.css-1x6ohry{color:green;}"];
  [@css ".css-j1z3s1.\000M.m\000{color:red;}"];
  [@css ".css-17pii80.\000M.Inner.m\000{color:blue;}"];
  [@css ".css-1gyt5cm.\000Box.Box\000{color:purple;}"];
  [@css.bindings
    [
      ("N.m", "css-1x6ohry"),
      ("N.panel", "css-1ct27kl css-j1z3s1 css-17pii80 css-1gyt5cm"),
    ]
  ];
  [@css.refs
    [
      ("M.m", "prod/n.ml", 6, 6, 9),
      ("M.Inner.m", "prod/n.ml", 7, 6, 15),
      ("Box.Box", "prod/n.ml", 8, 6, 13),
    ]
  ];
  let _ = M.m;
  let _ = M.Inner.m;
  let _ = Box.Box;
  let m = CSS.make("css-1x6ohry", []);
  let panel = CSS.make("css-1ct27kl css-j1z3s1 css-17pii80 css-1gyt5cm", []);

  $ refmt --parse ml --print re prod/bare.ml
  [@css.config [("env", "production")]];
  [@css ".css-1ed9z13 > .css-1ltob4l{color:blue;}"];
  [@css.bindings [("Bare.m", "css-1ltob4l"), ("Bare.list", "css-1ed9z13")]];
  let m = CSS.make("css-1ltob4l", []);
  let list = CSS.make("css-1ed9z13", []);

  $ styled-ppx.generate prod/m.ml prod/n.ml prod/box.ml prod/bare.ml
  /* This file is generated by styled-ppx, do not edit manually */
  .css-1xu3tth{color:black;}.css-1ct27kl.css-1hfcgi6{color:green;}.css-1j2bl2o:not(.css-1hfcgi6){color:red;}.css-1ct27kl.css-1x6ohry{color:green;}.css-j1z3s1.css-1hfcgi6{color:red;}.css-17pii80.css-1lkazb8{color:blue;}.css-1gyt5cm.css-10a400j-Box{color:purple;}.css-1ed9z13 > .css-1ltob4l{color:blue;}

The class depends on the module name, not on the file path or the
target: the same module compiled from another directory for native
gives the same output.

  $ mkdir native
  $ refmt --parse re --print ml m.re > native/m.ml
  $ ../../standalone.exe --env production --native --impl native/m.ml -o native/m.ml
  $ diff prod/m.ml native/m.ml
