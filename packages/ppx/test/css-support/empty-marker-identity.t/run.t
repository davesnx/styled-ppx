An empty `[%css {||}]` marker writes no rule, but it has a class: like every
block, its class is a hash of the module name, the submodule path, the
binding name and the (empty) content. The class must exist in production
too, and two markers with the same name in different modules must get
different classes.

Development:

  $ refmt --parse re --print ml m.re > m.ml
  $ ../../standalone.exe --env development --impl m.ml -o m.ml
  $ refmt --parse re --print ml n.re > n.ml
  $ ../../standalone.exe --env development --impl n.ml -o n.ml
  $ refmt --parse re --print ml box.re > box.ml
  $ ../../standalone.exe --env development --impl box.ml -o box.ml
  $ refmt --parse re --print ml bare.re > bare.ml
  $ ../../standalone.exe --env development --impl bare.ml -o bare.ml

`M.m`, `M.Inner.m` and `N.m` are three different markers.

  $ refmt --parse ml --print re m.ml
  [@css
    ".css-qr8vd5{color:black;}.css-qr8vd5.css-a8j9pk{color:green;}.css-qr8vd5:not(.css-a8j9pk){color:red;}"
  ];
  [@css.classes [("css-qr8vd5", 0, "M.card", "m.ml", 5, 2, 8, 0)]];
  [@css.bindings
    [
      ("M.m", "css-a8j9pk"),
      ("M.card", "css-qr8vd5"),
      ("M.Inner.m", "css-13mm6y9"),
    ]
  ];
  let m = CSS.make("cx-m css-a8j9pk", []);
  let card = CSS.make("cx-card css-qr8vd5", []);
  module Inner = {
    let m = CSS.make("cx-m css-13mm6y9", []);
  };

  $ refmt --parse ml --print re n.ml
  [@css
    ".css-p9fz1w.css-1sem5bw{color:green;}.css-p9fz1w.\000M.m\000{color:red;}.css-p9fz1w.\000M.Inner.m\000{color:blue;}.css-p9fz1w.\000Box.Box\000{color:purple;}"
  ];
  [@css.classes [("css-p9fz1w", 0, "N.panel", "n.ml", 5, 2, 9, 0)]];
  [@css.bindings [("N.m", "css-1sem5bw"), ("N.panel", "css-p9fz1w")]];
  [@css.refs
    [
      ("M.m", "n.ml", 6, 6, 9),
      ("M.Inner.m", "n.ml", 7, 6, 15),
      ("Box.Box", "n.ml", 8, 6, 13),
    ]
  ];
  let _: CSS.styles = M.m;
  let _: CSS.styles = M.Inner.m;
  let _ = Box.Box;
  let m = CSS.make("cx-m css-1sem5bw", []);
  let panel = CSS.make("cx-panel css-p9fz1w", []);

  $ refmt --parse ml --print re bare.ml
  [@css ".css-y2tco5 > .css-1bidjya{color:blue;}"];
  [@css.classes [("css-y2tco5", 0, "Bare.list", "bare.ml", 2, 20, 2, 46)]];
  [@css.bindings [("Bare.m", "css-1bidjya"), ("Bare.list", "css-y2tco5")]];
  let m = CSS.make("cx-m css-1bidjya", []);
  let list = CSS.make("cx-list css-y2tco5", []);

  $ styled-ppx.generate m.ml n.ml box.ml bare.ml
  /* This file is generated by styled-ppx, do not edit manually */
  .css-qr8vd5{color:black;}.css-qr8vd5.css-a8j9pk{color:green;}.css-qr8vd5:not(.css-a8j9pk){color:red;}
  .css-p9fz1w.css-1sem5bw{color:green;}.css-p9fz1w.css-a8j9pk{color:red;}.css-p9fz1w.css-13mm6y9{color:blue;}.css-p9fz1w.css-1g99equ{color:purple;}
  .css-y2tco5 > .css-1bidjya{color:blue;}

Production: every marker keeps a class and every `$(marker)` reference keeps
its condition.

  $ mkdir prod
  $ refmt --parse re --print ml m.re > prod/m.ml
  $ ../../standalone.exe --env production --impl prod/m.ml -o prod/m.ml
  $ refmt --parse re --print ml n.re > prod/n.ml
  $ ../../standalone.exe --env production --impl prod/n.ml -o prod/n.ml
  $ refmt --parse re --print ml box.re > prod/box.ml
  $ ../../standalone.exe --env production --impl prod/box.ml -o prod/box.ml
  $ refmt --parse re --print ml bare.re > prod/bare.ml
  $ ../../standalone.exe --env production --impl prod/bare.ml -o prod/bare.ml

  $ refmt --parse ml --print re prod/m.ml
