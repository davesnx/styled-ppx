The --env flag is a preset over the individual ppx flags: `development`
equals --dev (marker classes), `production` equals --minify (minified CSS, no
markers). The hashes are the same in both modes, only the cosmetic parts differ.

  $ refmt --parse re --print ml input.re > input.ml

With --env development, classNames carry a cx-<binding> marker, the
extracted rules are the same, and no [@@@css.config] is
emitted (absence means development).

  $ ../../standalone.exe --env development --impl input.ml -o dev.ml
  $ refmt --parse ml --print re dev.ml
  [@css.atoms
    [
      (
        "_a9fMU0SCS",
        ["._a9fMU0SCS{display:flex;}"],
        1,
        0,
        1,
        [("value", "MU0SCS", "val\\09f\\0& | \\0display:flex")],
      ),
      (
        "_afyDerD9l",
        ["._afyDerD9l{padding:12px;}"],
        1,
        0,
        4,
        [("value", "DerD9l", "val\\0fy\\0& | \\0padding:12px")],
      ),
      (
        "_a7fadbhEW",
        ["._a7fadbhEW{color:red;}"],
        1,
        0,
        1,
        [("value", "adbhEW", "val\\07f\\0& | \\0color:red")],
      ),
      (
        "_iQ7dl8ohV",
        [],
        1,
        0,
        0,
        [("id", "_iQ7dl8ohV", "bind\\0\\0Input\\0\\0layout\\00")],
      ),
      (
        "_iPt09eXEw",
        [],
        1,
        0,
        0,
        [("id", "_iPt09eXEw", "bind\\0\\0Input\\0\\0button\\00")],
      ),
    ]
  ];
  [@css.bindings
    [
      ("Input.layout", "_iQ7dl8ohV _a9fMU0SCS _afyDerD9l", "_iQ7dl8ohV"),
      ("Input.button", "_iPt09eXEw _a7fadbhEW", "_iPt09eXEw"),
    ]
  ];
  let layout = CSS.make("cx-layout _iQ7dl8ohV _a9fMU0SCS _afyDerD9l", []);
  let button = CSS.make("cx-button _iPt09eXEw _a7fadbhEW", []);
  let _ = (layout, button);
  $ styled-ppx.generate dev.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._afyDerD9l{padding:12px;}
  ._a9fMU0SCS{display:flex;}
  ._a7fadbhEW{color:red;}

With --env production, the same hashes appear without markers, and the PPX declares the environment in the wire
protocol so styled-ppx.generate minifies its output without any flag.

  $ ../../standalone.exe --env production --impl input.ml -o prod.ml
  $ refmt --parse ml --print re prod.ml
