This test ensures the ppx generates minified CSS with interpolations

  $ refmt --parse re --print ml input.re > output.ml
  $ ../../standalone.exe --minify --impl output.ml -o output.ml
  $ styled-ppx.generate output.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  @property --vdivq4v{syntax:"*";inherits:false;}@property --vdiv4xa{syntax:"*";inherits:false;}@property --vdivyt9{syntax:"*";inherits:false;}@property --vdivh5o{syntax:"*";inherits:false;}@property --vdivd9r{syntax:"*";inherits:false;}.css-vdivx9b{color:var(--vdivq4v);}.css-vdivrbg{margin:var(--vdiv4xa);padding:var(--vdivyt9);}.css-vdivt5m{background-color:var(--vdivh5o);border:1px solid var(--vdivd9r);}

