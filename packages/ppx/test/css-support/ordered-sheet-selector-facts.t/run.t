An attribute selector with `~=`, or with a space inside a quoted value,
styles the element itself: it has the specificity of `:hover`, and it
competes with it. Each block writes the attribute rule last, so it comes
after `:hover`:

  $ refmt --parse re --print ml input.re > input.ml
  $ ../../standalone.exe --impl input.ml -o output.ml
  $ cat output.ml
  [@@@css
    ("._a_qyw7u4ego80:hover{color:red;}", "_a_qyw7u4ego80", "0,2,0 own", "158",
      1, false)]
  [@@@css
    ("._a_se1ps4ekr3k[data-state~=\"open\"]{color:green;}", "_a_se1ps4ekr3k",
      "0,2,0 own", "158", 1, false)]
  [@@@css
    ("._a_13vvo4e2vbl[title=\"a b\"]{color:pink;}", "_a_13vvo4e2vbl",
      "0,2,0 own", "158", 1, false)]
  [@@@css.bindings
    [("Input.b", "_id_10vd5uv", "_a_qyw7u4ego80 _a_se1ps4ekr3k");
    ("Input.c", "_id_86o56d", "_a_qyw7u4ego80 _a_13vvo4e2vbl")]]
  [@@@css.blocks [(3, "_id_10vd5uv", [0; 1]); (4, "_id_86o56d", [0; 2])]]
  let b = CSS.make "label:b _id_10vd5uv _a_qyw7u4ego80 _a_se1ps4ekr3k" []
  let c = CSS.make "label:c _id_86o56d _a_qyw7u4ego80 _a_13vvo4e2vbl" []
  let _ = (b, c)
  $ styled-ppx.generate output.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_qyw7u4ego80:hover{color:red;}
  ._a_se1ps4ekr3k[data-state~="open"]{color:green;}
  ._a_13vvo4e2vbl[title="a b"]{color:pink;}
