Two submodules each define an empty `marker`, and a rule that qualifies on it
with `&.$(marker)`. `A.marker` and `B.marker` have different identity classes,
so `A.first` and `B.second` are different rules and each must keep its own
class and its own CSS rule. An element with `B.marker` and `B.second` must
match a color rule.

  $ refmt --parse re --print ml input.re > input.ml
  $ ../../standalone.exe --impl input.ml -o out.ml
  $ cat out.ml
  [@@@css "._a_72w1o4ecagl._id_1iohsq8{color:red;}"]
  [@@@css "._a_nqke54e3xpp._id_1yukm0j{color:red;}"]
  [@@@css.bindings
    [("Input.A.marker", "_id_1iohsq8", "");
    ("Input.A.first", "_id_1hiackk", "_a_72w1o4ecagl");
    ("Input.B.marker", "_id_1yukm0j", "");
    ("Input.B.second", "_id_z6g10d", "_a_nqke54e3xpp")]]
  [@@@css.blocks
    [(3, "_id_1iohsq8");
    (4, "_id_1hiackk _a_72w1o4ecagl");
    (8, "_id_1yukm0j");
    (9, "_id_z6g10d _a_nqke54e3xpp")]]
  module A =
    struct
      let marker = CSS.make "label:marker _id_1iohsq8" []
      let first = CSS.make "label:first _id_1hiackk _a_72w1o4ecagl" []
    end
  module B =
    struct
      let marker = CSS.make "label:marker _id_1yukm0j" []
      let second = CSS.make "label:second _id_z6g10d _a_nqke54e3xpp" []
    end

  $ styled-ppx.generate out.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_72w1o4ecagl._id_1iohsq8{color:red;}
  ._a_nqke54e3xpp._id_1yukm0j{color:red;}
