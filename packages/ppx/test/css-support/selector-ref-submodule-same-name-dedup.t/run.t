Two submodules each define an empty `marker`, and a rule that qualifies on it
with `&.$(marker)`. `A.marker` and `B.marker` have different identity classes,
so `A.first` and `B.second` are different rules and each must keep its own
class and its own CSS rule. An element with `B.marker` and `B.second` must
match a color rule.

  $ refmt --parse re --print ml input.re > input.ml
  $ ../../standalone.exe --impl input.ml -o out.ml
  $ cat out.ml
  [@@@css "._a_dr6aa4e3aq5._id_16nw92g{color:red;}"]
  [@@@css "._a_zdrnh4edp77._id_1o984wl{color:red;}"]
  [@@@css.bindings
    [("Input.A.marker", "_id_16nw92g", "");
    ("Input.A.first", "_id_1uvitr9", "_a_dr6aa4e3aq5");
    ("Input.B.marker", "_id_1o984wl", "");
    ("Input.B.second", "_id_165477j", "_a_zdrnh4edp77")]]
  module A =
    struct
      let marker = CSS.make "label:marker _id_16nw92g" []
      let first = CSS.make "label:first _id_1uvitr9 _a_dr6aa4e3aq5" []
    end
  module B =
    struct
      let marker = CSS.make "label:marker _id_1o984wl" []
      let second = CSS.make "label:second _id_165477j _a_zdrnh4edp77" []
    end

  $ styled-ppx.generate out.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_dr6aa4e3aq5._id_16nw92g,._t1_dr6aa4e3aq5._t1_dr6aa4e3aq5._id_16nw92g,._t2_dr6aa4e3aq5._t2_dr6aa4e3aq5._t2_dr6aa4e3aq5._id_16nw92g{color:red;}
  ._a_zdrnh4edp77._id_1o984wl,._t1_zdrnh4edp77._t1_zdrnh4edp77._id_1o984wl,._t2_zdrnh4edp77._t2_zdrnh4edp77._t2_zdrnh4edp77._id_1o984wl{color:red;}
