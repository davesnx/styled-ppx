Mixed same-module + cross-module references in one selector. Same-module
refs (`$(localFlag)`) resolve at PPX time, baking the resolved class
literally into the rendered CSS. Cross-module refs (`$(M.marker)`)
remain as sentinels until aggregation.

  $ refmt --parse re --print ml m.re > m.ml
  $ ../../standalone.exe --impl m.ml -o m.ml
  $ refmt --parse re --print ml n.re > n.ml
  $ ../../standalone.exe --impl n.ml -o n.ml

The post-PPX `n.ml` shows only the cross-module ref as a sentinel — the
same-module `localFlag` is already resolved to its class.

  $ refmt --parse ml --print re n.ml
  [@css ".css-1l1kf2v.css-1l27xrz.\000M.marker\000{color:blue;}"];
  [@css.classes [("css-1l1kf2v", 0, "N.container", "n.ml", 4, 2, 7, 0)]];
  [@css.bindings
    [("N.localFlag", "css-1l27xrz"), ("N.container", "css-1l1kf2v")]
  ];
  [@css.refs [("M.marker", "n.ml", 4, 19, 27)]];
  let _: CSS.styles = M.marker;
  let localFlag = CSS.make("css-1l27xrz", []);
  let container = CSS.make("css-1l1kf2v", []);

The aggregator resolves `M.marker`. Final output matches what an inlined
same-module reference would produce.

  $ styled-ppx.generate m.ml n.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  .css-1l1kf2v.css-1l27xrz.css-zqj71e{color:blue;}
