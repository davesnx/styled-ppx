A block's custom properties are named after the block's class: the class
hash, `-`, and a number for each distinct interpolation of the block, in
first-occurrence order. The same path read with the same type in several
rules of the block (`c` in the base rule, in `&:hover` and in `@media`)
is one variable. Two variables of two different blocks can never have the
same name, so the class collision check covers variables too.

  $ cat > input.ml <<EOF
  > let card c w = [%css {|
  >   color: \$(c);
  >   width: \$(w);
  >   &:hover { border-color: \$(c); }
  >   @media (min-width: 600px) { background-color: \$(c); }
  > |}]
  > let other c = [%css "color: \$(c)"]
  > EOF
  $ ../../standalone.exe --impl input.ml -o output.ml
  $ refmt --parse ml --print re output.ml
  [@css "@property --sidegi-0{syntax:\"*\";inherits:false;}"];
  [@css "@property --sidegi-1{syntax:\"*\";inherits:false;}"];
  [@css "@property --1ql477r-0{syntax:\"*\";inherits:false;}"];
  [@css
    ".css-sidegi{color:var(--sidegi-0);width:var(--sidegi-1);}.css-sidegi:hover{border-color:var(--sidegi-0);}@media (min-width: 600px) {.css-sidegi{background-color:var(--sidegi-0);}}"
  ];
  [@css ".css-1ql477r{color:var(--1ql477r-0);}"];
  [@css.classes
    [
      ("css-sidegi", 3, "Input.card", "input.ml", 2, 2, 6, 0),
      ("css-1ql477r", 4, "Input.other", "input.ml", 7, 21, 7, 32),
    ]
  ];
  [@css.bindings [("Input.card", ""), ("Input.other", "")]];
  let card = (c, w) =>
    CSS.make(
      "css-sidegi",
      [
        ("--sidegi-0", CSS.Types.Color.toString(c)),
        ("--sidegi-1", CSS.Types.Width.toString(w)),
      ],
    );
  let other = c =>
    CSS.make("css-1ql477r", [("--1ql477r-0", CSS.Types.Color.toString(c))]);
  $ styled-ppx.generate output.ml
  /* This file is generated by styled-ppx, do not edit manually */
  @property --sidegi-0{syntax:"*";inherits:false;}
  @property --sidegi-1{syntax:"*";inherits:false;}
  @property --1ql477r-0{syntax:"*";inherits:false;}
  .css-sidegi{color:var(--sidegi-0);width:var(--sidegi-1);}.css-sidegi:hover{border-color:var(--sidegi-0);}@media (min-width: 600px) {.css-sidegi{background-color:var(--sidegi-0);}}
  .css-1ql477r{color:var(--1ql477r-0);}
