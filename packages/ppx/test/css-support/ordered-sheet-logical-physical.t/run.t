  ._a_7r0002quz1{-webkit-margin-start:8px;margin-inline-start:8px;}
  ._a_740002zcbe{inset-inline-start:0;}
  ._a_7100021pq0{left:10px;}
  ._a_ecv99c{width:100px;}
