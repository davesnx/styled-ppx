`hoverParent`'s own condition is `:hover`, but the rule reaches past it,
via a descendant combinator, to a referenced child (`.$(child)`) with its
own identity class: `._a_...:hover ._id_...{color:red;}`. The rule styles
the referenced child, not `hoverParent`'s own element.

`linkOther`'s condition is `:link`, with no combinator at all:
`._a_...:link{color:blue;}`. The two rules have different specificity
(`.x:hover ._id_y` is (0,3,0); `.z:link` is (0,2,0)) and style different
elements, so they do not compete: no edge orders them and they keep their
definition order. This pins that sheet order; it is not a claim about which
one "wins" on a shared element. (Before the ordered sheet, a fixed
pseudo-class rank decided this order; that rank is gone.)

  $ refmt --parse re --print ml input.re > input.ml

  $ ../../standalone.exe --impl input.ml -o output.ml
  $ cat output.ml
  [@@@css
    ("._a_78s4s4esck0:hover ._id_kfnh2l{color:red;}", "_a_78s4s4esck0",
      "0,3,0 &:hover ._id_kfnh2l", "158", 1, false)]
  [@@@css
    ("._a_6diiq4e3si2:link{color:blue;}", "_a_6diiq4e3si2", "0,2,0 own", "158",
      1, false)]
  [@@@css.bindings
    [("Input.child", "_id_kfnh2l", "");
    ("Input.hoverParent", "_id_1lsockk", "_a_78s4s4esck0");
    ("Input.linkOther", "_id_1qo8psm", "_a_6diiq4e3si2")]]
  [@@@css.blocks
    [(1, "_id_kfnh2l", []); (2, "_id_1lsockk", [0]); (5, "_id_1qo8psm", [1])]]
  let child = CSS.make "label:child _id_kfnh2l" []
  let hoverParent = CSS.make "label:hoverParent _id_1lsockk _a_78s4s4esck0" []
  let linkOther = CSS.make "label:linkOther _id_1qo8psm _a_6diiq4e3si2" []
  let _ = (child, hoverParent, linkOther)

  $ styled-ppx.generate output.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_78s4s4esck0:hover ._id_kfnh2l{color:red;}
  ._a_6diiq4e3si2:link{color:blue;}
