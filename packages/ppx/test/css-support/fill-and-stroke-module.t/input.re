/* css-grammar-draft-properties: CSS Fill and Stroke Module Level 3,
   https://drafts.csswg.org/fill-stroke/ - the 16 fill- and stroke-
   properties this slice added (fill-rule/-opacity, stroke-width/-linecap/
   etc already existed). */
[%css {|fill-break: slice|}];
[%css {|fill-break: clone|}];
[%css {|fill-color: red|}];
[%css {|fill-image: none|}];
[%css {|fill-image: none, none|}];
[%css {|fill-origin: match-parent|}];
[%css {|fill-origin: fill-box|}];
[%css {|fill-position: center|}];
[%css {|fill-position: center, top left|}];
[%css {|fill-repeat: repeat-x|}];
[%css {|fill-repeat: repeat-x, space|}];
[%css {|fill-size: cover|}];
[%css {|fill-size: cover, 10px 20px|}];
[%css {|stroke-align: inset|}];
[%css {|stroke-break: bounding-box|}];
[%css {|stroke-dash-corner: none|}];
[%css {|stroke-dash-corner: 5px|}];
[%css {|stroke-dash-justify: none|}];
[%css {|stroke-dash-justify: stretch dashes|}];
[%css {|stroke-image: none|}];
[%css {|stroke-origin: stroke-box|}];
[%css {|stroke-position: 50% 50%|}];
[%css {|stroke-repeat: round|}];
[%css {|stroke-size: contain|}];
