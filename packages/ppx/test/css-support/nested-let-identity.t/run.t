A block's identity includes the top-level value binding that encloses it,
not the name of an inner `let`. A block bound to `s` inside `t` is not the
top-level `s`, and two functions with the same inner name get two classes.
Their variable is shared, as for any two blocks of one module with the same
interpolated text. `[@@@css.classes]` shows the path of value bindings
(`Input.t.s`), so a collision error points at a name the user can find.

  $ cat > input.ml <<EOF
  > let c = CSS.red
  > let s = [%css "color: red"]
  > let t = (let s = [%css "color: red"] in CSS.merge s s)
  > let u = [%css "& .\$(s) { outline: 1px solid }"]
  > let v = (let s = [%css "color: \$(c)"] in s)
  > let w = (let s = [%css "color: \$(c)"] in s)
  > EOF
  $ ../../standalone.exe --impl input.ml -o output.ml
  $ refmt --parse ml --print re output.ml
  [@css "@property --ivpcpc4{syntax:\"*\";inherits:false;}"];
  [@css ".css-ivpc1p8{color:red;}"];
  [@css ".css-ivpcge6{color:red;}"];
  [@css ".css-ivpcg2n .css-ivpc1p8{outline:1px solid;}"];
  [@css ".css-ivpcbd2{color:var(--ivpcpc4);}"];
  [@css ".css-ivpcivi{color:var(--ivpcpc4);}"];
  [@css.classes
    [
      ("css-ivpc1p8", 1, "Input.s", "input.ml", 2, 15, 2, 25),
      ("css-ivpcge6", 2, "Input.t.s", "input.ml", 3, 24, 3, 34),
      ("css-ivpcg2n", 3, "Input.u", "input.ml", 4, 15, 4, 45),
      ("css-ivpcbd2", 4, "Input.v.s", "input.ml", 5, 24, 5, 35),
      ("css-ivpcivi", 5, "Input.w.s", "input.ml", 6, 24, 6, 35),
    ]
  ];
  [@css.bindings
    [
      ("Input.s", "css-ivpc1p8"),
      ("Input.t", "css-ivpcge6"),
      ("Input.u", "css-ivpcg2n"),
      ("Input.v", "css-ivpcbd2"),
      ("Input.w", "css-ivpcivi"),
    ]
  ];
  let c = CSS.red;
  let s = CSS.make("css-ivpc1p8", []);
  let t = {
    let s = CSS.make("css-ivpcge6", []);
    CSS.merge(s, s);
  };
  let u = CSS.make("css-ivpcg2n", []);
  let v = {
    let s =
      CSS.make("css-ivpcbd2", [("--ivpcpc4", CSS.Types.Color.toString(c))]);
    s;
  };
  let w = {
    let s =
      CSS.make("css-ivpcivi", [("--ivpcpc4", CSS.Types.Color.toString(c))]);
    s;
  };
  $ styled-ppx.generate output.ml
  /* This file is generated by styled-ppx, do not edit manually */
  @property --ivpcpc4{syntax:"*";inherits:false;}
  .css-ivpc1p8{color:red;}
  .css-ivpcge6{color:red;}
  .css-ivpcg2n .css-ivpc1p8{outline:1px solid;}
  .css-ivpcbd2{color:var(--ivpcpc4);}
  .css-ivpcivi{color:var(--ivpcpc4);}

Inner `let`s that another ppx adds do not change the class: the native
component ppx wraps `styles=[%css ...]` in its own `let`s and copies it, the
Melange one does not, and both give the same sheet.

  $ cat > dune-project << EOF
  > (lang dune 3.10)
  > (using melange 0.1)
  > EOF
  $ mkdir native js
  $ cat > native/comp.re << EOF
  > module A = {
  >   [@react.component]
  >   let make = (~className=?) =>
  >     <div ?className styles=[%css "display: flex;"]> {React.string("ok")} </div>;
  > };
  > EOF
  $ cat > native/dune << EOF
  > (library
  >  (name comp_native)
  >  (libraries server-reason-react.react server-reason-react.reactDom styled-ppx.native)
  >  (preprocess (pps styled-ppx --native server-reason-react.ppx)))
  > EOF
  $ cat > js/dune << EOF
  > (copy_files ../native/comp.re)
  > (library
  >  (name comp_js)
  >  (modes melange)
  >  (libraries styled-ppx.melange reason-react)
  >  (preprocess (pps styled-ppx reason-react-ppx melange.ppx)))
  > EOF
  $ dune build @native/all @js/all
  $ styled-ppx.generate _build/default/native/comp.re.pp.ml > native.css
  $ styled-ppx.generate _build/default/js/.melange_src/comp.re.pp.ml > js.css
  $ diff native.css js.css
  1c1
  < /* This file is generated by styled-ppx, do not edit manually; libraries: comp_native */
  ---
  > /* This file is generated by styled-ppx, do not edit manually; libraries: comp_js */
  [1]
  $ cat native.css
  /* This file is generated by styled-ppx, do not edit manually; libraries: comp_native */
  .css-3ozbads{display:flex;}

An empty marker has no content to tell it apart, so its class uses the whole
binding path: two markers bound by inner `let`s of one top-level binding get
two classes.

  $ cat > markers.ml <<EOF
  > let styles = let root = [%css ""] in let item = [%css ""] in (root, item)
  > EOF
  $ ../../standalone.exe --impl markers.ml -o markers_out.ml
  $ refmt --parse ml --print re markers_out.ml
  [@css.classes
    [
      ("css-0g86y98", (-1), "Markers.styles.root", "markers.ml", 1, 31, 1, 31),
      ("css-0g86p0x", (-1), "Markers.styles.item", "markers.ml", 1, 55, 1, 55),
    ]
  ];
  [@css.bindings [("Markers.styles", "")]];
  let styles = {
    let root = CSS.make("css-0g86y98", []);
    let item = CSS.make("css-0g86p0x", []);
    (root, item);
  };
