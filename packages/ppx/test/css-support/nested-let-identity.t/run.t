A block's identity includes the top-level value binding that encloses it,
not the name of an inner `let`. A block bound to `s` inside `t` is not the
top-level `s`, and two functions with the same inner name get two classes
and two variables. `[@@@css.classes]` shows the path of value bindings
(`Input.t.s`), so a collision error points at a name the user can find.

  $ cat > input.ml <<EOF
  > let c = CSS.red
  > let s = [%css "color: red"]
  > let t = (let s = [%css "color: red"] in CSS.merge s s)
  > let u = [%css "& .\$(s) { outline: 1px solid }"]
  > let v = (let s = [%css "color: \$(c)"] in s)
  > let w = (let s = [%css "color: \$(c)"] in s)
  > EOF
  $ ../../standalone.exe --impl input.ml -o output.ml
  $ refmt --parse ml --print re output.ml
  [@css "@property --1gf9q86-0{syntax:\"*\";inherits:false;}"];
  [@css "@property --1x8670n-0{syntax:\"*\";inherits:false;}"];
  [@css ".css-1eor1p8{color:red;}"];
  [@css ".css-10jige6{color:red;}"];
  [@css ".css-aa0nw .css-1eor1p8{outline:1px solid;}"];
  [@css ".css-1gf9q86{color:var(--1gf9q86-0);}"];
  [@css ".css-1x8670n{color:var(--1x8670n-0);}"];
  [@css.classes
    [
      ("css-1eor1p8", 2, "Input.s", "input.ml", 2, 15, 2, 25),
      ("css-10jige6", 3, "Input.t.s", "input.ml", 3, 24, 3, 34),
      ("css-aa0nw", 4, "Input.u", "input.ml", 4, 15, 4, 45),
      ("css-1gf9q86", 5, "Input.v.s", "input.ml", 5, 24, 5, 35),
      ("css-1x8670n", 6, "Input.w.s", "input.ml", 6, 24, 6, 35),
    ]
  ];
  [@css.bindings
    [
      ("Input.s", "css-1eor1p8"),
      ("Input.t", "css-10jige6"),
      ("Input.u", "css-aa0nw"),
      ("Input.v", "css-1gf9q86"),
      ("Input.w", "css-1x8670n"),
    ]
  ];
  let c = CSS.red;
  let s = CSS.make("css-1eor1p8", []);
  let t = {
    let s = CSS.make("css-10jige6", []);
    CSS.merge(s, s);
  };
  let u = CSS.make("css-aa0nw", []);
  let v = {
    let s =
      CSS.make(
        "css-1gf9q86",
        [("--1gf9q86-0", CSS.Types.Color.toString(c))],
      );
    s;
  };
  let w = {
    let s =
      CSS.make(
        "css-1x8670n",
        [("--1x8670n-0", CSS.Types.Color.toString(c))],
      );
    s;
  };
  $ styled-ppx.generate output.ml
  /* This file is generated by styled-ppx, do not edit manually */
  @property --1gf9q86-0{syntax:"*";inherits:false;}
  @property --1x8670n-0{syntax:"*";inherits:false;}
  .css-1eor1p8{color:red;}
  .css-10jige6{color:red;}
  .css-aa0nw .css-1eor1p8{outline:1px solid;}
  .css-1gf9q86{color:var(--1gf9q86-0);}
  .css-1x8670n{color:var(--1x8670n-0);}

Inner `let`s that another ppx adds do not change the class: the native
component ppx wraps `styles=[%css ...]` in its own `let`s and copies it, the
Melange one does not, and both give the same sheet.

  $ cat > dune-project << EOF
  > (lang dune 3.10)
  > (using melange 0.1)
  > EOF
  $ mkdir native js
  $ cat > native/comp.re << EOF
  > module A = {
  >   [@react.component]
  >   let make = (~className=?) =>
  >     <div ?className styles=[%css "display: flex;"]> {React.string("ok")} </div>;
  > };
  > EOF
  $ cat > native/dune << EOF
  > (library
  >  (name comp_native)
  >  (libraries server-reason-react.react server-reason-react.reactDom styled-ppx.native)
  >  (preprocess (pps styled-ppx --native server-reason-react.ppx)))
  > EOF
  $ cat > js/dune << EOF
  > (copy_files ../native/comp.re)
  > (library
  >  (name comp_js)
  >  (modes melange)
  >  (libraries styled-ppx.melange reason-react)
  >  (preprocess (pps styled-ppx reason-react-ppx melange.ppx)))
  > EOF
  $ dune build @native/all @js/all
  $ styled-ppx.generate _build/default/native/comp.re.pp.ml > native.css
  $ styled-ppx.generate _build/default/js/.melange_src/comp.re.pp.ml > js.css
  $ diff native.css js.css
  $ cat native.css
  /* This file is generated by styled-ppx, do not edit manually */
  .css-1yo2ads{display:flex;}
