A bare `$(row)` selector reference in [%styled.global] is resolved against
the FULLY resolved rule text before `push_global` computes its dedup key
(unlike [%css]'s atomized path before this fix), so two modules with the
same local binding name and the same global selector shape were never at
risk of this collision - this pins that a `%styled.global` block using
`row` in A and B, with different content, emits two distinct global rules
rather than being silently merged into one.

  $ refmt --parse re --print ml a.re > a.ml
  $ ../../standalone.exe --impl a.ml -o a.ml
  $ refmt --parse re --print ml b.re > b.ml
  $ ../../standalone.exe --impl b.ml -o b.ml

  $ cat a.ml
  [@@@css "._id_wd60kt{cursor:pointer;}"]
  [@@@css
    ("._a_4ekvmb{color:red;}", "_a_4ekvmb", "0,1,0 own", "158", 1, false)]
  [@@@css.bindings [("A.row", "_id_wd60kt", "_a_4ekvmb")]]
  [@@@css.blocks [(1, "_id_wd60kt", [1])]]
  let row = CSS.make "label:row _id_wd60kt _a_4ekvmb" []
  module Globals =
    struct
      let to_string () = ""
      let makeProps ?key () = Js.Obj.empty ()[@@warning "-27-32"]
      let make _props = CSS.global_style_tag (to_string ())
    end

  $ cat b.ml
  [@@@css "._id_grd1wa{cursor:pointer;}"]
  [@@@css
    ("._a_4esm7b{color:blue;}", "_a_4esm7b", "0,1,0 own", "158", 1, false)]
  [@@@css.bindings [("B.row", "_id_grd1wa", "_a_4esm7b")]]
  [@@@css.blocks [(1, "_id_grd1wa", [1])]]
  let row = CSS.make "label:row _id_grd1wa _a_4esm7b" []
  module Globals =
    struct
      let to_string () = ""
      let makeProps ?key () = Js.Obj.empty ()[@@warning "-27-32"]
      let make _props = CSS.global_style_tag (to_string ())
    end

  $ styled-ppx.generate a.ml b.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  ._id_wd60kt{cursor:pointer;}
  ._id_grd1wa{cursor:pointer;}
  ._a_4ekvmb{color:red;}
  ._a_4esm7b{color:blue;}
