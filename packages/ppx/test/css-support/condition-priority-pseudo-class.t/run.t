One block, `:focus` written first, `:hover` written second, through the
real ppx (a REAL rendered selector `._a_...:focus{...}` and the real
`CSS.make` class list). The two rules compete (equal specificity, same
element, same property), so the block's class list gives generate a block
edge and the sheet follows the block's source order: `:hover`, written
last, sorts last and wins when both apply, as in plain CSS.

  $ refmt --parse re --print ml input.re > input.ml

  $ ../../standalone.exe --impl input.ml -o output.ml
  $ cat output.ml
  [@@@css
    ("._a_0lub34ebzcl:focus{color:blue;}", "_a_0lub34ebzcl", "0,2,0 own",
      "158", 1, false)]
  [@@@css
    ("._a_qyw7u4ego80:hover{color:red;}", "_a_qyw7u4ego80", "0,2,0 own", "158",
      1, false)]
  [@@@css.bindings
    [("Input.danger", "_id_1156lfl", "_a_0lub34ebzcl _a_qyw7u4ego80")]]
  [@@@css.blocks [(2, "_id_1156lfl", [0; 1])]]
  let danger =
    CSS.make "label:danger _id_1156lfl _a_0lub34ebzcl _a_qyw7u4ego80" []
  let _ = danger

  $ styled-ppx.generate output.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_0lub34ebzcl:focus{color:blue;}
  ._a_qyw7u4ego80:hover{color:red;}
