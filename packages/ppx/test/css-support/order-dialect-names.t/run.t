dune names a preprocessed Reason file `<name>.re.pp.ml` and an mlx file
`<name>.mlx.pp.ml`. The module name is the part before the first `.`, so
`App` reaches `Base` and `Base`'s rule comes first, against alphabetical
order.

  $ cat > base.ml <<EOF
  > let base = [%css "padding: 0"]
  > EOF

  $ cat > app.ml <<EOF
  > let app = [%css "padding: 4px"]
  > let _ = Base.base
  > EOF

  $ for m in app base; do ../../standalone.exe -cookie 'library-name="ui"' --impl $m.ml --dump-ast -o $m.re.pp.ml; done

  $ styled-ppx.generate --log debug app.re.pp.ml base.re.pp.ml
  styled-ppx: output file: stdout
  styled-ppx: library order: ui
  styled-ppx: order: ui: Base, App
  styled-ppx: edge: App -> Base
  styled-ppx: environment: development
  styled-ppx: stylesheet:
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_94aj3r{padding:0;}
  ._a_94lxtj{padding:4px;}
  
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_94aj3r{padding:0;}
  ._a_94lxtj{padding:4px;}

The same holds for mlx.

  $ for m in app base; do ../../standalone.exe -cookie 'library-name="ui"' --impl $m.ml --dump-ast -o $m.mlx.pp.ml; done

  $ styled-ppx.generate --log debug app.mlx.pp.ml base.mlx.pp.ml
  styled-ppx: output file: stdout
  styled-ppx: library order: ui
  styled-ppx: order: ui: Base, App
  styled-ppx: edge: App -> Base
  styled-ppx: environment: development
  styled-ppx: stylesheet:
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_94aj3r{padding:0;}
  ._a_94lxtj{padding:4px;}
  
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_94aj3r{padding:0;}
  ._a_94lxtj{padding:4px;}
