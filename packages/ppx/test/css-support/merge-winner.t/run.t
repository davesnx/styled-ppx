When two merged blocks set the same property, the block that comes later in
the sheet wins. `CSS.merge` argument order has no effect: both orders below
give an element both classes, and the sheet has `first` before `second`, so
`color: blue` from `second` applies to both elements.

  $ cat > dune-project << EOF
  > (lang dune 3.10)
  > EOF

  $ mkdir native

  $ cat > native/dune << EOF
  > (executable
  >  (name main)
  >  (libraries
  >   server-reason-react.react
  >   server-reason-react.reactDom
  >   styled-ppx.native)
  >  (preprocess
  >   (pps styled-ppx --native server-reason-react.ppx)))
  > EOF

  $ cat > native/blocks.re << EOF
  > let first = [%css "color: red; padding: 1px"];
  > let second = [%css "color: blue"];
  > EOF

  $ cat > native/main.re << EOF
  > let el = (~id, s) =>
  >   <div id className={CSS.className(s)} style={CSS.styles(s)} />;
  > let page =
  >   <div>
  >     {el(~id="first_second", CSS.merge(Blocks.first, Blocks.second))}
  >     {el(~id="second_first", CSS.merge(Blocks.second, Blocks.first))}
  >   </div>;
  > let () = print_endline(ReactDOM.renderToStaticMarkup(page));
  > EOF

  $ dune build

  $ ./_build/default/native/main.exe
  <div><div class="css-1apt37t css-7cz3u5" style="" id="first_second"></div><div class="css-7cz3u5 css-1apt37t" style="" id="second_first"></div></div>

  $ styled-ppx.generate _build/default/native/blocks.re.pp.ml
  /* This file is generated by styled-ppx, do not edit manually */
  .css-1apt37t{color:red;padding:1px;}
  .css-7cz3u5{color:blue;}
