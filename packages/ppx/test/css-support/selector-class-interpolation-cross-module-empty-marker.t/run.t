The canonical empty-marker idiom: cross-module refs to bindings whose
[%css] body is empty. The marker classes carry no rules of their own,
they only serve as "tags" that consumers chain into selectors.

  $ refmt --parse re --print ml m.re > m.ml
  $ ../../standalone.exe --impl m.ml -o m.ml
  $ refmt --parse re --print ml n.re > n.ml
  $ ../../standalone.exe --impl n.ml -o n.ml

The PPX records two distinct cross-module refs and one synthetic dep per
distinct longident.

  $ refmt --parse ml --print re n.ml
  [@css
    ".css-tfflch{display:none;}.css-tfflch.\000M.isOpen\000{display:block;}.css-tfflch.\000M.isHovered\000{background:rgba(0, 0, 0, 0.1);}"
  ];
  [@css.classes [("css-tfflch", 0, "N.modal", "n.ml", 4, 2, 8, 0)]];
  [@css.bindings [("N.modal", "css-tfflch")]];
  [@css.refs
    [("M.isOpen", "n.ml", 6, 6, 14), ("M.isHovered", "n.ml", 7, 6, 17)]
  ];
  let _: CSS.styles = M.isOpen;
  let _: CSS.styles = M.isHovered;
  let modal = CSS.make("css-tfflch", []);

  $ styled-ppx.generate m.ml n.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  .css-tfflch{display:none;}.css-tfflch.css-10hjlfs{display:block;}.css-tfflch.css-9ev41u{background:rgba(0, 0, 0, 0.1);}
