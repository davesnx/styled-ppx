The canonical empty-marker idiom: cross-module refs to bindings whose
[%css] body is empty. The marker classes carry no rules of their own,
they only serve as "tags" that consumers chain into selectors.

  $ refmt --parse re --print ml m.re > m.ml
  $ ../../standalone.exe --impl m.ml -o m.ml
  $ refmt --parse re --print ml n.re > n.ml
  $ ../../standalone.exe --impl n.ml -o n.ml

The PPX records two distinct cross-module refs and one synthetic dep per
distinct longident.

  $ refmt --parse ml --print re n.ml
  [@css "._a_5rfx7x{display:none;}"];
  [@css "._a_bti1z5rn55o.\000M.isOpen\000{display:block;}"];
  [@css "._a_pkso639fi5u.\000M.isHovered\000{background:rgba(0, 0, 0, 0.1);}"];
  [@css.bindings
    [("N.modal", "_id_1g7stmc", "_a_5rfx7x _a_bti1z5rn55o _a_pkso639fi5u")]
  ];
  [@css.refs
    [("M.isOpen", "n.ml", 6, 6, 14), ("M.isHovered", "n.ml", 7, 6, 17)]
  ];
  let _ = M.isOpen;
  let _ = M.isHovered;
  let modal =
    CSS.make(
      "label:modal _id_1g7stmc _a_5rfx7x _a_bti1z5rn55o _a_pkso639fi5u",
      [],
    );

  $ styled-ppx.generate m.ml n.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  @layer styled-ppx.global, styled-ppx.descendant, styled-ppx.base, styled-ppx.conditional;
  @layer styled-ppx.base {
  ._a_5rfx7x{display:none;}
  ._a_bti1z5rn55o._id_1fhciug{display:block;}
  ._a_pkso639fi5u._id_145hsfw{background:rgba(0, 0, 0, 0.1);}
  }
