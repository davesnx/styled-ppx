/* css-grammar-draft-properties: CSS Generated Content L3
   (https://drafts.csswg.org/css-content-3/) and CSS Generated Content for
   Paged Media (https://drafts.csswg.org/css-gcpm/). */
[%css {|bookmark-label: "Chapter"|}];
[%css {|bookmark-label: counter(chapter)|}];
[%css {|bookmark-level: none|}];
[%css {|bookmark-level: 2|}];
[%css {|bookmark-state: open|}];
[%css {|bookmark-state: closed|}];
[%css {|string-set: none|}];
[%css {|string-set: header "Chapter One"|}];
[%css {|string-set: header "Chapter One", footer "Page"|}];
[%css {|running: none|}];
[%css {|running: myHeader|}];
[%css {|footnote-display: block|}];
[%css {|footnote-display: inline|}];
[%css {|footnote-display: compact|}];
[%css {|footnote-policy: auto|}];
[%css {|footnote-policy: line|}];
[%css {|footnote-policy: block|}];
