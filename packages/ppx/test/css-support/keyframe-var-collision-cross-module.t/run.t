Regression guard: cross-module [%keyframe] interpolation does not collide.

Two modules define the byte-identical interpolated keyframe `grow` plus a
`[%css animation-name: $(grow)]` binding, differing only in a sibling
declaration. This confirms the keyframe path is free of the atomic class/var
collision that affected [%css] backgrounds.

Two hashing schemes meet here, both routed through Hash_class.
First, the `animation-name: $(grow)` atom is hashed from its own declaration, so
its class and its variable are identical in both modules and the aggregator
dedupes the rule to a single line.
Second, the keyframe itself is namespaced by kind+module+scope
(Hash_class.scoped_namespace), so its internal height variables - and thus its
content-hashed keyframe-<hash> name - differ per module; the two keyframes are
emitted under distinct names. The namespace is keyed on the compilation-unit
module name, not the physical file path, so the same module compiled from two
paths agrees on one keyframe name.

Why this is safe: custom properties resolve per element. Each module's `grow`
sets the shared animation-name variable to ITS OWN keyframe name and, on the same
element, sets that keyframe's internal height variables. Every element thus
resolves the animation-name variable and the keyframe body against values it
actually set - no element references a variable it did not set. The
per-module divergence lives in the keyframe NAME (a value), never in a shared
class pointing at a missing variable.

  $ refmt --parse re --print ml a.re > a.ml
  $ ../../standalone.exe --impl a.ml -o a.ml
  $ refmt --parse re --print ml b.re > b.ml
  $ ../../standalone.exe --impl b.ml -o b.ml
  $ cat a.ml
  [@@@css
    "@keyframes keyframe-1h1i3op{0%{height:var(--h0-9tm5yy);}100%{height:var(--h1-mjt56l);}}"]
  [@@@css.atoms
    [("_a41TXJC6U",
       ["._a41TXJC6U{-webkit-animation-name:var(--grow-1si0nwn);animation-name:var(--grow-1si0nwn);}"],
       1, 0, 1,
       [("value", "TXJC6U", "val\\041\\0& | \\0animation-name:$(grow)")]);
    ("_a9fMU0SCS", ["._a9fMU0SCS{display:flex;}"], 1, 0, 1,
      [("value", "MU0SCS", "val\\09f\\0& | \\0display:flex")]);
    ("_iNARLt0_H", [], 1, 0, 0,
      [("id", "_iNARLt0_H", "bind\\0\\0A\\0\\0box\\00")])]]
  [@@@css.bindings
    [("A.box", "_iNARLt0_H _a41TXJC6U _a9fMU0SCS", "_iNARLt0_H")]]
  let h0 = `px 0
  let h1 = `px 100
  let grow =
    CSS.Types.AnimationName.make
      ~vars:[("--h0-9tm5yy", (CSS.Types.Height.toString h0));
            ("--h1-mjt56l", (CSS.Types.Height.toString h1))] "keyframe-1h1i3op"
  let box =
    CSS.make "_iNARLt0_H _a41TXJC6U _a9fMU0SCS"
      (CSS.Types.AnimationName.toStyleVars "--grow-1si0nwn" grow)
  $ cat b.ml
  [@@@css
    "@keyframes keyframe-1arknxa{0%{height:var(--h0-yrpn7p);}100%{height:var(--h1-1oxv8aa);}}"]
  [@@@css.atoms
    [("_a41TXJC6U",
       ["._a41TXJC6U{-webkit-animation-name:var(--grow-1si0nwn);animation-name:var(--grow-1si0nwn);}"],
       1, 0, 1,
       [("value", "TXJC6U", "val\\041\\0& | \\0animation-name:$(grow)")]);
    ("_afy3_uoZc", ["._afy3_uoZc{padding:8px;}"], 1, 0, 4,
      [("value", "3_uoZc", "val\\0fy\\0& | \\0padding:8px")]);
    ("_iqQtggOQk", [], 1, 0, 0,
      [("id", "_iqQtggOQk", "bind\\0\\0B\\0\\0box\\00")])]]
  [@@@css.bindings
    [("B.box", "_iqQtggOQk _a41TXJC6U _afy3_uoZc", "_iqQtggOQk")]]
  let h0 = `px 0
  let h1 = `px 100
  let grow =
    CSS.Types.AnimationName.make
      ~vars:[("--h0-yrpn7p", (CSS.Types.Height.toString h0));
            ("--h1-1oxv8aa", (CSS.Types.Height.toString h1))]
      "keyframe-1arknxa"
  let box =
    CSS.make "_iqQtggOQk _a41TXJC6U _afy3_uoZc"
      (CSS.Types.AnimationName.toStyleVars "--grow-1si0nwn" grow)
  $ styled-ppx.generate a.ml b.ml > styles.css
  $ cat styles.css
  /* This file is generated by styled-ppx, do not edit manually */
  @keyframes keyframe-1h1i3op{0%{height:var(--h0-9tm5yy);}100%{height:var(--h1-mjt56l);}}
  @keyframes keyframe-1arknxa{0%{height:var(--h0-yrpn7p);}100%{height:var(--h1-1oxv8aa);}}
  ._afy3_uoZc{padding:8px;}
  ._a41TXJC6U{-webkit-animation-name:var(--grow-1si0nwn);animation-name:var(--grow-1si0nwn);}
  ._a9fMU0SCS{display:flex;}
