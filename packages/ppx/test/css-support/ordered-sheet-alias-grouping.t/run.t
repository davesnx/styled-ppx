`grid-row-gap` is a legacy alias of `row-gap`, so the two declarations set
the same longhand and group into one atom, in source order:

  $ refmt --parse re --print ml input.re > input.ml
  $ ../../standalone.exe --impl input.ml -o output.ml
  $ cat output.ml
  [@@@css
    ("._a_6f0002zmlg{row-gap:2px;grid-row-gap:1px;}", "_a_6f0002zmlg",
      "0,1,0 own", "231", 2, false)]
  [@@@css.bindings [("Input.gaps", "_id_1ovjt24", "_a_6f0002zmlg")]]
  [@@@css.blocks [(1, "_id_1ovjt24", [0])]]
  let gaps = CSS.make "label:gaps _id_1ovjt24 _a_6f0002zmlg" []
  let _ = gaps
  $ styled-ppx.generate output.ml
  /* This file is generated by styled-ppx, do not edit manually */
  ._a_6f0002zmlg{row-gap:2px;grid-row-gap:1px;}
