  let simpleShadow = CSS.make "css-ivpc6x3" []
  let multipleShadows = CSS.make "css-ivpcxmz" []
  let insetShadow = CSS.make "css-ivpc1aa" []
  let noShadow = CSS.make "css-ivpcbqy" []
  let spreadShadow = CSS.make "css-ivpceur" []
  let simpleBorder = CSS.make "css-ivpc8pq" []
  let borderWithColor = CSS.make "css-ivpcszt" []
  let borderTransparent = CSS.make "css-ivpce59" []
  let noBorder = CSS.make "css-ivpcky7" []
  let borderStyles = CSS.make "css-ivpcj6r" []
  let borderSeparate = CSS.make "css-ivpcmf3" []
  let borderWithRadius = CSS.make "css-ivpcn7j" []
  let shadowAndBorder = CSS.make "css-ivpc9d5" []
  let cardStyle = CSS.make "css-ivpcskc" []
  let buttonBase = CSS.make "css-ivpc63n" []
  let borderColorInterp borderColor =
    CSS.make "css-ivpc0x9"
      [("--ivpcwyy", (CSS.Types.Color.toString borderColor))]
  let shadowInterp shadowX =
    fun shadowY ->
      fun blur ->
        fun spread ->
          fun shadowColor ->
            CSS.make "css-ivpcqfn"
              [("--ivpcwta", (CSS.Types.Length.toString shadowX));
              ("--ivpcp7h", (CSS.Types.Length.toString shadowY));
              ("--ivpcc08", (CSS.Types.Length.toString blur));
              ("--ivpcly3", (CSS.Types.Length.toString spread));
              ("--ivpcoj7", (CSS.Types.Color.toString shadowColor))]
  let shadowFullInterp myShadow =
    CSS.make "css-ivpc5vb"
      [("--ivpc4ko", (CSS.Types.BoxShadows.toString myShadow))]
  let borderWidthInterp borderWidth =
    CSS.make "css-ivpcpqf"
      [("--ivpcf2w", (CSS.Types.LineWidth.toString borderWidth))]
  let mixedCard bgColor =
    fun borderColor ->
      fun shadow ->
        CSS.make "css-ivpce9x"
          [("--ivpcgwf", (CSS.Types.Color.toString bgColor));
          ("--ivpcotj", (CSS.Types.Color.toString borderColor));
          ("--ivpcbmw", (CSS.Types.BoxShadows.toString shadow))]
