  .css-ivpc6x3{box-shadow:0px 2px 4px 0px rgba(0, 0, 0, 0.1);}
  .css-ivpcxmz{box-shadow:0px 2px 4px 0px rgba(0, 0, 0, 0.1), 0px 4px 8px 0px rgba(0, 0, 0, 0.2);}
  .css-ivpc1aa{box-shadow:inset 0px 2px 4px 0px rgba(0, 0, 0, 0.1);}
  .css-ivpcbqy{box-shadow:none;}
  .css-ivpceur{box-shadow:0px 4px 6px -1px rgba(0, 0, 0, 0.1), 0px 2px 4px -2px rgba(0, 0, 0, 0.1);}
  .css-ivpc8pq{border:1px solid black;}
  .css-ivpcszt{border:2px dashed #ff0000;}
  .css-ivpce59{border:1px solid transparent;}
  .css-ivpcky7{border:none;}
  .css-ivpcj6r{border-top:1px solid red;border-right:2px dashed blue;border-bottom:3px dotted green;border-left:4px double orange;}
