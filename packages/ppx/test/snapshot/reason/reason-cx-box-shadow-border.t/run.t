  @property --ivpcwyy{syntax:"*";inherits:false;}
  @property --ivpcwta{syntax:"*";inherits:false;}
  @property --ivpcp7h{syntax:"*";inherits:false;}
  @property --ivpcc08{syntax:"*";inherits:false;}
  @property --ivpcly3{syntax:"*";inherits:false;}
  @property --ivpcoj7{syntax:"*";inherits:false;}
  @property --ivpc4ko{syntax:"*";inherits:false;}
  @property --ivpcf2w{syntax:"*";inherits:false;}
  @property --ivpcgwf{syntax:"*";inherits:false;}
  @property --ivpcotj{syntax:"*";inherits:false;}
