; This tests ensure the transformation goes right and doesn't need to type-check.
; If you are looking for CSS Support tests check packages/ppx/test/native folder.

(subdir
 reason
 (cram
  (alias test-ppx-snapshot-reason)
  (deps
   %{exe:../../standalone.exe}
   %{bin:refmt}
   (package styled-ppx)))
 ; These snapshots contain error locations and source excerpts into the
 ; refmt-generated output.ml. refmt prints that file through the host
 ; compiler's Pprintast, whose layout differs between OCaml versions.
 (cram
  (applies_to
   reason-dynamic-array
   reason-dynamic-interpolation-default-value
   reason-dynamic-sequence
   reason-dynamic-with-array
   reason-dynamic-with-ident
   reason-dynamic-with-sequence-out-scope
   reason-media-queries-and-selectors-interpolation
   reason-native-dynamic-interpolation-default-value
   reason-styled-global2-selector-interp-forward-ref-error
   reason-styled-global2-selector-interp-undefined-error
   reason-styled-global2-top-level-ampersand-error
   reason-warning-old-api)
  (enabled_if
   (>= %{ocaml_version} 5.4.0))))
