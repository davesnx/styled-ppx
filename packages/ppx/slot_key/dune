(library
 (name slot_key)
 ; Depends on css-grammar for its property/shorthand data (Css_grammar's
 ; Shorthand kind + Registry query API - see slot_key.ml's Family/Registry
 ; modules) and on murmur2/styled_ppx_css_parser for the same hashing and
 ; parsed-rule shapes `ppx` uses. No ppxlib dependency: this library has no
 ; PPX-facing surface of its own. Not yet depended on by `ppx`.
 (package styled-ppx)
 (libraries murmur2 styled_ppx_css_parser Css_grammar))
