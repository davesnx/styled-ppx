(executable
 (name registry_properties)
 (modules registry_properties)
 (libraries Css_grammar))

(rule
 (targets property_table.gen cover.gen data.gen reference.gen)
 (deps
  gen_tables.ts
  registry_names.txt
  ../../cx-conformance/coverage.json
  ../core/css_property_table.ml)
 (action
  (run
   node
   --experimental-strip-types
   --no-warnings
   gen_tables.ts
   --table-out
   property_table.gen
   --cover-out
   cover.gen
   --data-out
   data.gen
   --reference-out
   reference.gen)))

(rule
 (alias test-property-class)
 (action
  (progn
   (diff ../core/css_property_table.ml property_table.gen)
   (diff ../core/css_cover.ml cover.gen)
   (diff ../core/css_cover_data.ml data.gen)
   (diff ../core/test/cover_reference.ml reference.gen))))
