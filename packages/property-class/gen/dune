(executable
 (name registry_properties)
 (modules registry_properties)
 (libraries Css_grammar))

(rule
 (targets property_table.gen cover.gen)
 (deps
  gen_tables.ts
  registry_names.txt
  ../../cx-conformance/coverage.json
  ../core/css_property_table.ml)
 (action
  (run
   node
   --experimental-strip-types
   --no-warnings
   gen_tables.ts
